% Generated by hand from roxygen2 comments in R/nutrigon_compare.R
\name{nutrigon_compare}
\alias{nutrigon_compare}
\title{Compare two nutritional optima and bootstrap the angular separation}
\usage{
nutrigon_compare(data1, x1_col, y1_col, z1_col, data2, x2_col, y2_col,
  z2_col, design_id_col1 = NULL, design_id_col2 = NULL, paired = TRUE,
  peak1 = TRUE, peak2 = TRUE, B = 200, n_cloud = 500,
  n_reps_cloud = 5, seed = NULL)
}
\arguments{
\item{data1, data2}{Data frames for traits 1 and 2. Can be the same object
if both traits were measured on the same individuals.}

\item{x1_col, y1_col, z1_col}{Column names for surface 1.}

\item{x2_col, y2_col, z2_col}{Column names for surface 2.}

\item{design_id_col1, design_id_col2}{Design-point ID columns (can be
\code{NULL}). Only used when \code{paired = FALSE}.}

\item{paired}{\code{TRUE} (default) if both traits were measured on the
same individuals (resamples individuals jointly, using \code{data1}/
\code{data2} row correspondence). \code{FALSE} for unpaired data,
resampled independently (optionally within design points via
\code{design_id_col1}/\code{design_id_col2}).}

\item{peak1, peak2}{\code{TRUE} to locate maxima; \code{FALSE} for minima.}

\item{B}{Number of bootstrap resamples (default 200; use 500 for
publication-quality results).}

\item{n_cloud}{Monte Carlo fallback cloud size.}

\item{n_reps_cloud}{Number of MC draws per replicate.}

\item{seed}{Optional random seed for reproducibility.}
}
\value{
An object of class \code{"nutrigon_comparison"}, a list with:
\describe{
  \item{theta_hat}{Point estimate of angular separation (degrees).}
  \item{ci}{Named vector \code{c(lower_95, upper_95)} for the 95\% percentile
    bootstrap CI.}
  \item{theta1, theta2}{Component angles (degrees from origin).}
  \item{boot_diffs}{Vector of \code{B} bootstrap angular separations.}
  \item{n_fallback}{Number of bootstrap resamples that failed (and were
    excluded from the CI).}
}
}
\description{
Fits two quadratic response surfaces and computes the angular separation
theta between their nutritional optima, together with a bootstrap
percentile confidence interval. Supports paired resampling (both traits
measured on the same individuals) and unpaired resampling with optional
resampling by design point.
}
\examples{
data(lee_drosophila)
result <- nutrigon_compare(
  lee_drosophila, "protein_eaten", "carb_eaten", "lifespan",
  lee_drosophila, "protein_eaten", "carb_eaten", "dailyeggs",
  design_id_col1 = "treatment", design_id_col2 = "treatment",
  paired = TRUE, B = 50, seed = 1
)
print(result)

}
