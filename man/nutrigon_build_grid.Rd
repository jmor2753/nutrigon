% Generated by hand from roxygen2 comments in R/nutrigon_build_grid.R
\name{nutrigon_build_grid}
\alias{nutrigon_build_grid}
\title{Build a reusable validation grid for the reliability diagnostic}
\usage{
nutrigon_build_grid(n = 20, n_sim = 8, B_boot = 50, seed = 42,
  theta_min = 5.71, theta_max = 84.29)
}
\arguments{
\item{n}{Number of random configurations (default 20 for a quick check;
50-100 recommended for thorough diagnostics).}

\item{n_sim}{Simulated datasets per configuration (default 8; 20 for more
reliable ground-truth coverage estimates).}

\item{B_boot}{Bootstrap resamples per simulated dataset (default 50).}

\item{seed}{Random seed.}

\item{theta_min, theta_max}{Angular support of your design (degrees).}
}
\value{
A data frame with columns \code{max_elongation}, \code{min_edge_distance},
\code{angle_diff}, and \code{coverage} (ground-truth empirical coverage).
}
\description{
Builds a grid of simulated configurations spanning a range of curvature
elongations and angular separations, runs real bootstrap simulations for
each, and records ground-truth empirical coverage. The result is used by
\code{\link{nutrigon_check}} to assess whether a specific applied result
resembles configurations that validated well or poorly.
}
\details{
This function is computationally intensive (it runs real bootstrap
simulations for every grid configuration). Build once and reuse for all
comparisons made under the same design. The package ships a pre-built
grid, \code{nutrigon_validation_grid} (\code{seed = 2025}), so most users
will not need to call this function directly -- see
\code{data(nutrigon_validation_grid)}.
}
\examples{
\donttest{
grid <- nutrigon_build_grid(n = 5, n_sim = 3, B_boot = 20, seed = 1)
head(grid)
}
}
\seealso{
\code{\link{nutrigon_check}}
}
